# ===================================================================
# AI Support Fabric Lab v3.0 - Environment Configuration
# ===================================================================
# Copy this file to .env and fill in the values
# WARNING: Never commit .env file to version control!
# ===================================================================

# -------------------------------------------------------------------
# SECURITY - API Authentication
# -------------------------------------------------------------------
# Comma-separated list of valid API keys for authentication
# Generate strong random keys: openssl rand -hex 32
API_KEYS=dev-key-DO-NOT-USE-IN-PRODUCTION,test-key-2

# -------------------------------------------------------------------
# SECURITY - CORS Configuration
# -------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
# For production: Set to specific domains only
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -------------------------------------------------------------------
# SERVICE CONFIGURATION
# -------------------------------------------------------------------
# Debug mode (NEVER set to true in production!)
DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Service ports
GATEWAY_PORT=8080
TELEMETRY_COLLECTOR_PORT=8081
AGENTIC_AI_PORT=8082
UI_DASHBOARD_PORT=3000

# -------------------------------------------------------------------
# DATABASE & STORAGE
# -------------------------------------------------------------------
# SQLite database path for telemetry storage
TELEMETRY_STORAGE_PATH=/data/telemetry.db

# TimescaleDB connection (v3.0+ feature)
# DATABASE_URL=postgresql://ailab:password@timescaledb:5432/telemetry

# -------------------------------------------------------------------
# INTER-SERVICE COMMUNICATION
# -------------------------------------------------------------------
# URLs for service-to-service communication
TELEMETRY_COLLECTOR_URL=http://telemetry_collector:8081
AGENTIC_AI_URL=http://agentic_ai:8082
UI_DASHBOARD_URL=http://ui_dash:3000

# -------------------------------------------------------------------
# LLM PROVIDERS - AI/ML Features
# -------------------------------------------------------------------
# Anthropic Claude API
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI GPT API
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Default LLM provider (anthropic, openai, local)
LLM_PROVIDER=anthropic

# LLM model size (small, medium, large)
LLM_MODEL_SIZE=medium

# -------------------------------------------------------------------
# RATE LIMITING
# -------------------------------------------------------------------
# Redis URL for distributed rate limiting
REDIS_URL=memory://

# -------------------------------------------------------------------
# OBSERVABILITY - Monitoring & Metrics
# -------------------------------------------------------------------
# Prometheus metrics enabled
PROMETHEUS_METRICS_ENABLED=true

# Structured logging format (json, text)
LOG_FORMAT=json

# -------------------------------------------------------------------
# ML MODEL CONFIGURATION
# -------------------------------------------------------------------
# Path to trained ML models
ML_MODELS_PATH=/data/models

# ML model file for anomaly detection
ML_ANOMALY_MODEL=anomaly_detection.joblib

# -------------------------------------------------------------------
# PLUGIN SYSTEM
# -------------------------------------------------------------------
# Directories to load plugins from (comma-separated)
PLUGIN_DIRS=./plugins,./plugins/examples

# -------------------------------------------------------------------
# MULTI-TENANCY (v3.0+ feature)
# -------------------------------------------------------------------
# Enable multi-tenancy
MULTI_TENANCY_ENABLED=false

# Default tenant ID
DEFAULT_TENANT_ID=default

# ===================================================================
# Remember to:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to git (it's in .gitignore)
# 4. Generate strong API keys for production
# 5. Set DEBUG=false in production
# ===================================================================
